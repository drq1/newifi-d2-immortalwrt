# 目标硬件：Newifi 3 (D-Team Newifi D2 / MT7621)
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# 基础 Web 界面与简体中文支持
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# 1. 核心网络加速：Turbo ACC 网络加速引擎 (包含 BBR、流量分流卸载、DNS加速)
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_PDNSD=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# 2. CPU 多核中断平衡 (让 MT7621 双核 4 线程平摊千兆流量中断)
CONFIG_PACKAGE_irqbalance=y

# 3. 核心代理面板：HomeProxy (内置专为 MIPS softfloat 优化的 sing-box 核心)
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y

# 4. 网络唤醒 (WOL)
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# 5. KMS 激活服务器 (vlmcsd)
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

# 6. ZeroTier 异地组网/内网穿透
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# 7. AdGuard Home 控制管理界面 (核心存放在 /tmp 内存或 U 盘运行)
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y

# 8. 存储与磁盘挂载 (支持 USB 3.0 / USB 2.0 / Ext4 / FAT / 磁盘管理)
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y

# 9. 硬件加速底层驱动支持
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y
